@page "/rental/selectcarsforrental"

@using AppForSEII2526.Web.API
@using Microsoft.AspNetCore.Authorization
@inject AppForSEII2526APIClient apiclient
@inject ILogger<SelectCarsForRental> logger
@inject RentalStateContainer rentalState
@inject NavigationManager navigation




<h3>Seleccione los coches que desea alquilar</h3>
<div class="container-fluid">
    <div class="row alert alert-danger" role="alert" hidden="@hideErrors">
        <p id="ErrorsShown">Errors: @errors</p>
    </div>
    <div class="row">
        <div class="col-8">
            <div class="row">
                <div class="col">
                    <div class="input-group mb-3">
                        <span class="input-group-text" id="basic-addon1">Filtre por precio</span>
                        <input type="text" id="rentingPrice" @bind=priceforrenting class="form-control" placeholder="Precio" aria-label="Precio" aria-describedby="basic-addon1">
                    </div>
                </div>
                <div class="col">
                    <div class="input-group mb-3">
                        <span class="input-group-text" id="basic-addon1">Filtre por modelo</span>
                        <input type="text" id="modelCar" @bind=carModel class="form-control" placeholder="Modelo" aria-label="Modelo" aria-describedby="basic-addon1">
                    </div>
                </div>
                <div class="col">
                    <button type="button" class="btn btn-primary" @onclick=@SearchCars id="searchCars">Buscar coches</button>
                </div>

            </div>
            <div class="row">
                @if (cars == null)
                {
                    <p>Cargando coches....</p>
                }
                else
                {
                    <div class="mh-100 table-responsive">
                        <table class="table table-condensed table-hover" id="TableOfCars">
                            <thead>
                                <tr>
                                    <th>Fabricante</th>
                                    <th>Modelo</th>
                                    <th>Color</th>
                                    <th>Precio de renta</th>
                                    <th>Tipo de combustible</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var car in cars)
                                {
                                    <tr id="CarData_@car.Id">
                                        <td>@car.Manufacturer</td>
                                        <td>@car.Model</td>
                                        <td>@car.Color</td>
                                        <td>@car.PriceForRenting</td>
                                        <td>@car.FuelType</td>
                                        <td>
                                            <button class="btn btn-outline-secondary" id="carToRent_@car.Model" @onclick="@(() => AddCar(car))">Añadir</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                }
            </div>
        </div>
        <div class="col-2" hidden="@hideRentingCart"
            id="showRentingCart">
            <div class="row" ">
                <h3>Carrito de alquiler</h3>
            </div>
            @foreach (RentalItemDTO item in rental.RentalItems)
            {
                <div class="row">
                    <button type="button" class="btn btn-light" id="removeCar_@item.Model" @onclick="@(() => RemoveRentalItem(item))">x @item.Model - @item.RentingPrice€</button>
                </div>
            }
            <div class="row">
                <button type="button" class="btn btn-primary" id="rentalCarButton" @onclick=@RentCars disabled="@(rental.RentalItems.Count == 0)">Alquilar coche/s</button>
            </div>
        </div>

    </div>

</div>





@code {
    private string carModelSelected;
    private ICollection<string>? modelsNames = new List<string>();
    private bool hideRentingCart { get { return rental.RentalItems.Count == 0; } }
    private ICollection<CarForRentalDTO> cars;
    private bool hideErrors { get { return errors.Length == 0; } }
    private string errors = "";
    private string carModel { get; set; }
    private double? priceforrenting { get; set; }


    private RentalForCreateDTO rental => rentalState.Rental;

    private bool hiddenRentingCart = true;

    private void AddCar(CarForRentalDTO car)
    {
        rentalState.AddCarToRental(car);
    }

    private void RemoveRentalItem(RentalItemDTO item)
    {
        rentalState.RemoveRentalItemToRent(item);
        if (rental.RentalItems.Count == 0) hiddenRentingCart = true;
    }

    public async void SearchCars()
    {
        try
        {
            cars = await apiclient.GetCarForRentalAsync(carModel, priceforrenting);
            errors = "";
        }
        catch (ApiException ex)
        {
            logger.LogError($"{DateTime.Now} Error: {ex}");
            errors = "Error while connecting to the system";
        }
        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {

        try
        {
            modelsNames = await apiclient.GetModelsAsync(null);
        }
        catch (ApiException ex)
        {
            if (modelsNames == null) modelsNames = new List<string>() { "All" };
            logger.LogError("Error! There was an error while connecting to the GetModelsAsync service");
        }

        SearchCars();
    }
    private void RentCars()
    {
        navigation.NavigateTo("/rental/createrental");
    }


}

