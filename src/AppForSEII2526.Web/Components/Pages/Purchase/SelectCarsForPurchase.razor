@page "/purchase/selectcarsforpurchase"

@using Microsoft.AspNetCore.Authorization
@using AppForSEII2526.Web.API
@inject AppForSEII2526APIClient apiclient
@inject ILogger<SelectCarsForPurchase> logger
@inject PurchaseStateContainer purchaseState
@inject NavigationManager navigation

@attribute [Authorize]

<h3>Select Cars For Purchase</h3>
<div class="container-fluid">
    <div class="row alert alert-danger" role="alert" hidden="@hideErrors">
        <p id="ErrorsShown">Errors: @errors</p>
    </div>
    <div class="row">
        <div class="col-8">
            <div class="row">
                <div class="col">
                    <div class="input-group mb-3">
                        <span class="input-group-text" id="basic-addon1">Filtrado color</span>
                        <input type="text" id="inputTitle" @bind=carColor class="form-control" placeholder="Filtrado por color" aria-label="Filtrado por color" aria-describedby="basic-addon1">
                    </div>
                </div>
                <div class="col">
                    <div class="input-group mb-3">
                        <span class="input-group-text" id="basic-addon1">Filtrado modelo</span>
                        <input type="text" id="inputTitle" @bind=carModel class="form-control" placeholder="Filtrado por modelo" aria-label="Filtrado por modelo" aria-describedby="basic-addon1">
                    </div>
                </div>
                <div class="col">
                    <button type="button" class="btn btn-primary" @onclick=@SearchCars id="searchCars">Search cars</button>
                </div>

            </div>
            <div class="row">
                @if (cars == null) {
                    <p>Loading cars....</p>
                }
                else
                {
                    <div class="mh-100 table-responsive">
                        <table class="table table-condensed table-hover" id="TableOfCars">
                            <thead>
                                <tr>
                                    <th>Fabricante</th>
                                    <th>Modelo</th>
                                    <th>Color</th>
                                    <th>Precio de compra</th>
                                    <th>Tipo de combustible</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var car in cars) {
                                    <tr id="CarData_@car.Id">
                                        <td>@car.Manufacturer</td>
                                        <td>@car.Model</td>
                                        <td>@car.Color</td>
                                        <td>@car.PurchasingPrice</td>
                                        <td>@car.FuelType</td>
                                        <td>
                                            <button class="btn btn-outline-secondary" id="movieToRent_@car.Model" @onclick="@(() => AddCar(car))">Add</button>
                                        </td>
                                    </tr>
                                }
                        </tbody>
                    </table>
                    </div>

                }
            </div>
        </div>
        <div class="col-2" hidden="@hidePurchasingCart">
            <div class="row">
                <h3>Shopping Cart</h3>
            </div>
            @foreach (PurchaseItemDTO item in purchase.PurchaseItems) {
                <div class="row">
                    <button type="button" class="btn btn-light" id="removeMovie_@item.Model" @onclick="@(() => RemovePurchaseItem(item))">x @item.Model - @item.PurchasingPrice€</button>
                </div>
            }
            <div class="row">
                <button type="button" class="btn btn-primary" id="purchaseMovieButton" @onclick=@PurchaseCars>Comprar coche</button>
            </div>
        </div>

    </div>

</div>

@code {
    private string carModelSelected;
    private ICollection<string>? modelsNames = new List<string>();
    private bool hidePurchasingCart { get { return purchase.PurchaseItems.Count == 0; } }
    private ICollection<CarForPurchaseDTO> cars;
    private bool hideErrors { get { return errors.Length == 0; } }
    private string errors = "";
    private string carColor { get; set; }
    private string carModel { get; set; }

    private PurchaseForCreateDTO purchase => purchaseState.Purchase;

    private bool hiddenPurchaseCart = true;

    private void AddCar(CarForPurchaseDTO car)
    {
        purchaseState.AddCarToPurchase(car);
    }

    private void RemovePurchaseItem(PurchaseItemDTO item)
    {
        purchaseState.RemovePurchaseItemToPurchase(item);
        if (purchase.PurchaseItems.Count == 0) hiddenPurchaseCart = true;
    }

    public async void SearchCars()
    {
        try
        {
            cars = await apiclient.GetCarForPurchaseAsync(carColor, carModel);
            errors = "";

        }
        catch (ApiException ex)
        {
            logger.LogError($"{DateTime.Now} Error: {ex}");
            errors = "Error de conexión al sistema";
        }
        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {

        try
        {
            modelsNames = await apiclient.GetModelsAsync(null);
        }
        catch (ApiException ex)
        {
            if (modelsNames == null) modelsNames = new List<string>() { "All", };
            logger.LogError("Error! There was an error while connecting to the GetModelsAsync service");
        }

        SearchCars();

        // return base.OnInitializedAsync();
    }

    private void PurchaseCars()
    {
        navigation.NavigateTo("/purchase/post"); 
    }
}