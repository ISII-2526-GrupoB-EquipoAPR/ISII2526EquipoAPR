@page "/review/createreview"

@using AppForSEII2526.Web.API
@using AppForSEII2526.Web.Components.Shared
@using Microsoft.AspNetCore.Authorization

@inject AppForSEII2526APIClient apiclient
@inject ReviewStateContainer reviewState
@inject NavigationManager navigation
@inject ILogger<CreateReview> logger

@attribute [Authorize]

<h3>Crear reseña</h3>

<EditForm Model="review" OnValidSubmit="OpenDialog">
    <DataAnnotationsValidator />
    <ValidationSummary class="alert alert-danger" />

    <div class="row alert alert-danger" hidden="@hideErrors">
        <p id="ErrorsShown">Errors: @messageError</p>
    </div>

    <!-- Datos del usuario -->
    <div class="row g-3">
        <div class="col-md">
            <div class="form-floating mb-3">
                <InputText @bind-Value="review.CustomerUserName" class="form-control" id="CustomerUserName" />
                <label for="CustomerUserName">Nombre de usuario (email)</label>
            </div>
        </div>

        <div class="col-md">
            <div class="form-floating mb-3">
                <InputText @bind-Value="review.Country" class="form-control" id="Country" />
                <label for="Country">País</label>
            </div>
        </div>

        <div class="col-md">
            <div class="form-floating">
                <InputSelect class="form-select" @bind-Value="review.DriverType" id="DriverType">
                    <option value=""></option>
                    <option value="Novato">Novato</option>
                    <option value="Experto">Experto</option>
                </InputSelect>
                <label for="DriverType">Tipo de conductor</label>
            </div>
        </div>
    </div>

    <h4>Coches para reseñar</h4>

    <div class="mh-100 table-responsive">
        <table class="table table-condensed table-hover" id="TableOfReviewItems">
            <thead>
                <tr>
                    <th>Modelo</th>
                    <th>Fabricante</th>
                    <th>Combustible</th>
                    <th>Color</th>
                    <th>Descripción</th>
                    <th>Valoración (1–5)</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in review.ReviewItems)
                {
                    <tr id="CreateReviewItem_@item.CarID">
                        <td>@item.Model</td>
                        <td>@item.Manufacturer</td>
                        <td>@item.Fueltype</td>
                        <td>@item.Color</td>
                        <td>
                            <InputText class="form-control"
                                       id="@($"descripciontxt_{item.CarID}")"
                                       @bind-Value="item.ReviewDescription" />
                        </td>
                        <td>
                            <input class="form-control"
                                   type="text"
                                   id="ratingtxt_@item.CarID"
                                   value="@item.Rating"
                                   inputmode="numeric"
                                   pattern="[1-5]*"
                                   @oninput="e => OnRatingChanged(e, item)" />
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="row mt-3">
        <div class="col">
            <button class="btn btn-outline-primary"
                    @onclick="ModifyCars"
                    type="button">
                Modificar coches
            </button>
        </div>

        <div class="col text-end">
            <button class="btn btn-primary" type="submit" id="Submit">
                Publicar reseña
            </button>
        </div>
    </div>
</EditForm>

@if (DialogIsOpen)
{
    <Dialog Caption="Publicar reseña"
            Message="¿Seguro que quieres publicar la reseña?"
            OnClose="@OnDialogClose"
            Type=Dialog.Category.SaveNot>
    </Dialog>
}

@code {

    private string messageError = "";
    private bool hideErrors => messageError.Length == 0;
    private bool DialogIsOpen;

    private ReviewForCreateDTO review => reviewState.Review;

    private void ModifyCars()
    {
        navigation.NavigateTo("/review/selectcarsforreview");
    }

    private void OpenDialog()
    {
        DialogIsOpen = true;
    }

    private async Task OnDialogClose(bool isOk)
    {
        DialogIsOpen = false;

        if (!isOk) return;

        if (review.ReviewItems.Count == 0)
        {
            messageError = "Debes reseñar al menos un coche.";
            return;
        }

        try
        {
            var createdReview = await apiclient.CreateReviewAsync(review);

            reviewState.ReviewProcessed();

            navigation.NavigateTo($"/review/detailreview?ReviewID={createdReview.Id}");
        }
        catch (ApiException<ValidationProblemDetails> ex)
        {
            messageError = "";
            foreach (var errors in ex.Result.Errors.Values)
                messageError = string.Join("(*) ", messageError, string.Join(" (*) ", errors));
        }
        catch (ApiException)
        {
            messageError = "Error al procesar la solicitud, inténtelo de nuevo más tarde.";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (authenticationState is not null)
        {
            var authState = await authenticationState;
            var user = authState?.User;

            if (user is not null && user.Identity is not null && user.Identity.IsAuthenticated)
            {
                review.CustomerUserName = user.Identity.Name;
            }

            review.CustomerUserName = review.CustomerUserName == null ? "" : review.CustomerUserName;
            review.Country = review.Country == null ? "" : review.Country;
            review.DriverType = review.DriverType == null ? "" : review.DriverType;
        }
    }

    [CascadingParameter]
    private Task<AuthenticationState>? authenticationState { get; set; }

    private void OnRatingChanged(ChangeEventArgs e, ReviewItemsDTO item)
    {
        var value = e.Value?.ToString();

        if (int.TryParse(value, out var rating))
        {
            item.Rating = rating;
        }
        else
        {
            item.Rating = 0;
        }
    }
}
