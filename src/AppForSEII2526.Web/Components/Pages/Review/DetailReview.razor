@page "/review/detailreview"

@using AppForSEII2526.Web.API
@using Microsoft.AspNetCore.Authorization
@inject AppForSEII2526APIClient apiclient

@attribute [Authorize]

<h3>Detalles de la reseña</h3>

@if (review == null)
{
    <p id="ErrorMessage">@error</p>
}
else
{
    <table class="table table-borderless table-sm">
        <tr>
            <th>Usuario</th>
            <td id="ReviewerUserName">@review.CustomerUserName</td>
        </tr>
        <tr>
            <th>País</th>
            <td id="ReviewerCountry">@review.Country</td>
        </tr>
        <tr>
            <th>Tipo de conductor</th>
            <td id="ReviewerDriverType">@review.DriverType</td>
        </tr>
    </table>

    <h4>Coches reseñados</h4>

    <table class="table" id="ReviewedCars">
        <thead>
            <tr>
                <th>Modelo</th>
                <th>Fabricante</th>
                <th>Tipo de combustible</th>
                <th>Color</th>
                <th>Descripción</th>
                <th>Puntuación</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in review.ReviewItems)
            {
                <tr id="ReviewItem_@item.CarID">
                    <td>@item.Model</td>
                    <td>@item.Manufacturer</td>
                    <td>@item.Fueltype</td>
                    <td>@item.Color</td>
                    <td>@item.ReviewDescription</td>
                    <td>@item.Rating</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    [Parameter]
    [SupplyParameterFromQuery]
    public int ReviewID { get; set; }

    private ReviewDetailDTO? review;
    private string error = "";

    [CascadingParameter]
    private Task<AuthenticationState>? authenticationState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        // 1. Comprobar si el usuario está logueado
        string userName = "";

        if (authenticationState is not null)
        {
            var authState = await authenticationState;
            var user = authState?.User;

            if (user != null && user.Identity != null && user.Identity.IsAuthenticated)
            {
                userName = user.Identity.Name;
            }
        }

        // 2. Llamar al API para obtener la reseña
        try
        {
            review = await apiclient.GetReviewsAsync(ReviewID);
        }
        catch (ApiException)
        {
            review = null;
        }

        // 3. Comprobar si la reseña pertenece al usuario actual
        if (review == null || review.CustomerUserName != userName)
        {
            error = $"Error: No estás autorizado o no existe la reseña con ID={ReviewID}";
            review = null;
        }
    }
}
