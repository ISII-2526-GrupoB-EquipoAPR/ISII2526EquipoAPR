@page "/review/selectcarsforreview"

@using Microsoft.AspNetCore.Authorization
@using AppForSEII2526.Web.API
@inject AppForSEII2526APIClient apiclient
@inject ILogger<SelectCarsForReview> logger
@inject ReviewStateContainer reviewState
@inject NavigationManager navigation



<h3>Select Cars For Review</h3>
<div class="container-fluid">
    <div class="row alert alert-danger" role="alert" hidden="@hideErrors">
        <p id="ErrorsShown">Errors: @errors</p>
    </div>
    <div class="row">
        <div class="col-8">
            <div class="row">
                <div class="col">
                    <div class="input-group mb-3">
                        <span class="input-group-text" id="basic-addon1">Filtrado Fabricante</span>
                        <input type="text" id="inputManufacturer" @bind=Manufacturer class="form-control" placeholder="Filtrado por Fabricante" aria-label="Filtrado por color" aria-describedby="basic-addon1">
                    </div>
                </div>
                <div class="col">
                    <div class="input-group mb-3">
                        <span class="input-group-text" id="basic-addon1">Filtrado Combustible</span>
                        <input type="text" id="inputFuelType" @bind=Fueltype class="form-control" placeholder="Filtrado por Combustible" aria-label="Filtrado por modelo" aria-describedby="basic-addon1">
                    </div>
                </div>
                <div class="col">
                    <button type="button" class="btn btn-primary" @onclick=@SearchCars id="searchCars">Search cars</button>
                </div>

            </div>
            <div class="row">
                @if (cars == null)
                {
                    <p>Loading cars....</p>
                }
                else
                {
                    <div class="mh-100 table-responsive">
                        <table class="table table-condensed table-hover" id="TableOfCars">
                            <thead>
                                <tr>
                                    <th>Fabricante</th>
                                    <th>Modelo</th>
                                    <th>Color</th>
                                    <th>Tipo de combustible</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var car in cars)
                                {
                                    <tr id="CarData_@car.Modelo">
                                        <td>@car.Manufacturer</td>
                                        <td>@car.Modelo</td>
                                        <td>@car.Color</td>
                                        <td>@car.FuelType</td>
                                        <td>
                                            <button class="btn btn-outline-secondary" id="carToReview_@car.Id" @onclick="@(() => AddCar(car))">Add</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                }
            </div>
        </div>
        <div class="col-2" hidden="@hideReviewCart">
            <div class="row">
                <h3>Shopping Cart</h3>
            </div>
            @foreach (ReviewItemsDTO item in review.ReviewItems)
            {
                <div class="row">
                    <button type="button" class="btn btn-light" id="removeCar_@item.CarID" @onclick="@(() => RemoveReviewItem(item))">x @item.Manufacturer @item.Model (@item.Color)</button>
                </div>
            }
            <div class="row mt-2">
                <button type="button" class="btn btn-primary" id="continueReviewButton" @onclick=@ReviewedCars>Continuar</button>
            </div>
        </div>

    </div>

</div>

@code {
    private string carModelSelected;
    private ICollection<string>? modelsNames = new List<string>();
    private bool hideReviewCart { get { return review.ReviewItems.Count == 0; } }
    private ICollection<CarForReviewDTO> cars;
    private bool hideErrors { get { return errors.Length == 0; } }
    private string errors = "";
    private string Manufacturer { get; set; }
    private string Fueltype { get; set; }

    private ReviewForCreateDTO review => reviewState.Review;

    private bool hiddenPurchaseCart = true;

    private void AddCar(CarForReviewDTO car)
    {
        reviewState.AddCarToReview(car);
        StateHasChanged();
    }

    private void RemoveReviewItem(ReviewItemsDTO item)
    {
        reviewState.RemoveReviewItemToReview(item);
        if (review.ReviewItems.Count == 0) hiddenPurchaseCart = true;
    }

    public async void SearchCars()
    {
        try
        {
            cars = await apiclient.GetCarForReviewAsync(Manufacturer, Fueltype);
            errors = "";

        }
        catch (ApiException ex)
        {
            logger.LogError($"{DateTime.Now} Error: {ex}");
            errors = "Error de conexión al sistema";
        }
        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {

        try
        {
            modelsNames = await apiclient.GetModelsAsync(null);
        }
        catch (ApiException ex)
        {
            if (modelsNames == null) modelsNames = new List<string>() { "All", };
            logger.LogError("Error! There was an error while connecting to the GetModelsAsync service");
        }

        SearchCars();

        // return base.OnInitializedAsync();
    }

    private void ReviewedCars()
    {
        navigation.NavigateTo("/review/createreview");
    }

}