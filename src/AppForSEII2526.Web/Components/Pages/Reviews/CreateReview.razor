﻿@page "/reviews/createreview"

@inject NavigationManager navigation
@using AppForSEII2526.Web.API
@using Microsoft.AspNetCore.Authorization
@using AppForSEII2526.Web.Components.Shared
@inject AppForSEII2526APIClient apiclient
@inject ILogger<CreateReview> logger
@inject ReviewStateContainer reviewState

@attribute [Authorize]

<h3>Realizar reseña</h3>
@* purchase is the object that will be edited thanks to the form *@
<EditForm Model="review" OnValidSubmit="OpenDialog">
    <div class="row">
        <DataAnnotationsValidator />
        <ValidationSummary class="row alert alert-danger" />
    </div>
    <div class="row alert alert-danger" role="alert" hidden="@hideErrors">
        <p id="ErrorsShown">Errors: @messageError</p>
    </div>
    <div class="row g-3">
        <div class="col-md">
            <div class="form-floating mb-3">
                <InputText @bind-Value="review.CustomerUserName" class="form-control" id="Email" />
                <label for="Email">Email </label>
            </div>
        </div>
        <div class="col-md">
            <div class="form-floating mb-3">
                <InputText @bind-Value="review.rating" class="form-control" id="Apellidos" />
                <label for="Nombre y apellidos">Rating </label>
            </div>
        </div>
        <div class="col-md">
            <div class="form-floating mb-3">
                <InputText @bind-Value="review.Description" class="form-control" id="Dirección" />
                <label for="Dirección">Descripcion</label>
            </div>
        </div>
    </div>
    <div class="row g-2">
        <div class="col-md">
            <div class="form-floating">
                @*this button will be used to ask the user if he want to proceed to rent the movies*@
                <button class="btn btn-primary" type="submit" id="Submit" disabled="@reviewButtonDisabled">
                    Reseña tus coches
                </button>
            </div>
        </div>     
    </div>

    <div class="mh-100 table-responsive">
        <table class="table table-condensed table-hover" id="TableOfReviewedItems">
            <thead>
                <tr>
                    <th>Modelo</th>
                    <th>Color</th>
                    <th>Descripción</th>
                    <th>Rating</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in review.ReviewItems)
                {
                    <tr id="CarData_@item.Model">
                        <td>@item.Model</td>
                        <td>@item.Color</td>
                        <td>@item.Description</td>
                        <td>@item.Rating</td>
                      
                    </tr>
                }
            </tbody>
        </table>
    </div>
</EditForm>
@if (DialogIsOpen)
{
    <Dialog Caption="Comprar coches"
            Message="¿Está seguro de que quiere comprar los coches seleccionados?"
            OnClose="@OnDialogClose"
            Type=Dialog.Category.SaveNot>
    </Dialog>
}

@code {
    private string messageError = "";
    private bool hideErrors { get { return messageError.Length == 0; } }
    //purchasebutton will be disabled if there are not cars in the purchasing cart
    private bool reviewButtonDisabled { get { return (review.ReviewItems == null || review.ReviewItems.Count == 0); } }
    private bool DialogIsOpen;
    
    private void ModifyReviewItems()
    {
        navigation.NavigateTo("/purchase/selectcarsforreview");
    }
    private ReviewForCreateDTO review => reviewState.Review;

    private void OpenDialog()
    {
        DialogIsOpen = true;
    }

    private async Task OnDialogClose(bool isOk)
    {

        DialogIsOpen = false;
        if (isOk)
        {
            // Process the data introduced by the user if they are valid
            if (review.ReviewItems.Count > 0)
            {
                try
                {
                    var review = await apiclient.CreateRentalAsync();
                    reviewState.ReviewProcessed();
                    navigation.NavigateTo($"/review/detailreview/? ReviewID={review.Id}");
                }
                catch (ApiException<ValidationProblemDetails> apiexceptionvalidation)
                {

                    if (apiexceptionvalidation.Result.Errors.Values != null)
                    {
                        messageError = "";
                        foreach (var errors in apiexceptionvalidation.Result.Errors.Values)
                            //https://learn.microsoft.com/en-us/dotnet/api/system.string.join?view=net-7.0
                            messageError = string.Join("(*) ", messageError, string.Join(" (*) ", errors));
                    }
                }
                catch (ApiException apiexception)
                {
                    //we need to inform user that there was some other error while processing the request
                    messageError = "Error while processing your request, please try again later!";

                }

            }
        }
    }

    protected override async Task OnInitializedAsync()
    {

        if (authenticationState is not null)
        {
            var authState = await authenticationState;
            var user = authState?.User;

            if (user is not null)
            {
                if (user.Identity is not null && user.Identity.IsAuthenticated)
                {
                    review.CustomerUserName = user.Identity.Name;
                }
            }
            review.CustomerUserName = review.CustomerUserName == null ? "" : review.CustomerUserName;
            
            review.Rating = review.Rating == null ? "" : review.Rating;

        }
    }

    [CascadingParameter]
    private Task<AuthenticationState>? authenticationState { get; set; }
}